{
  "expo": {
    "name": "Total Mundo",
    "slug": "total",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#2F5FE0"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f97a5787-61fb-48da-9b9b-1e73f953242d"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sylexpress.mallexpirytracker",
      "infoPlist": {
        "NSCameraUsageDescription": "Se necesita acceso a la cámara para escanear códigos de barras.",
        "NSUserNotificationsUsageDescription": "Total Mundo necesita enviarte alertas de vencimiento de productos."
      }
    },
    "android": {
      "package": "com.sylexpress.mallexpirytracker",
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite que $(PRODUCT_NAME) acceda a tu cámara para escanear códigos de barras."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2F5FE0",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f97a5787-61fb-48da-9b9b-1e73f953242d"
      }
    },
    "owner": "syl-express"
  }
}
